# handled.ai backend configuration -- copy to `.env` and fill in.
# `.env` is gitignored; never commit real secrets.

# --- Database ---------------------------------------------------------------
# Runtime connection: a NON-superuser role, so Postgres RLS is enforced.
DATABASE_URL=postgresql://handled_app:CHANGE_ME@localhost:5432/handled_dev
# Superuser connection: used only for DDL / migrations / RLS setup.
DATABASE_URL_ADMIN=postgresql://postgres:CHANGE_ME@localhost:5432/handled_dev

# --- Auth ----------------------------------------------------------------------
JWT_SECRET=generate-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- LLM (prototype only) ----------------------------------------------------
# Provider: ollama (local, no cost) | anthropic | openai | gemini
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
# Only needed for the matching hosted provider:
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Advisory only -- set the real cap on the provider's billing dashboard.
LLM_MONTHLY_SPEND_CAP_USD=20

# --- CrewAI guardrails (runaway-loop protection) --------------------------
CREW_MAX_ITER=6
CREW_MAX_RPM=10
